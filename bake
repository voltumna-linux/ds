#!/usr/bin/env bash

set -euo pipefail
trap 'printf "Errore alla riga %s\n" "$LINENO" >&2' ERR

read -r -d '' DATI <<'EOF' || true
naples-kvm image ds-sde public wic
naples-kvm image ds-sre public wic
naples-kvm sdk ds-sdk public sh
rome-kvm image ds-sde public wic
rome-kvm image ds-sre public wic
rome-kvm sdk ds-sdk public sh
ivybridge-kvm image ds-sde public wic
ivybridge-kvm image ds-sre public wic
ivybridge-kvm sdk ds-sdk public sh
skylake-kvm image ds-sde public wic
skylake-kvm image ds-sre public wic
skylake-kvm sdk ds-sdk public sh
cascadelake-kvm image ds-sde public wic
cascadelake-kvm image ds-sre public wic
cascadelake-kvm sdk ds-sdk public sh
EOF

build_all() {
    local FAILED=()

    exec 3<<< "$DATI"

    # shellcheck disable=SC2034  # outputdir/format are columns of the table shared with release
    while read -r -u 3 machine type image outputdir format; do
        export MACHINE="$machine"

        case "$type" in
            image)
                if ! nice bitbake -k "$image"; then
                    FAILED+=("${machine}/${image}")
                fi
                ;;
            sdk)
                continue
                ;;
            *)
                printf 'Type unknown: %s\n' "$type" >&2
                exit 1
                ;;
        esac
    done

    exec 3<&-

    if (( ${#FAILED[@]} )); then
        printf 'Failed builds:\n' >&2
        printf '  %s\n' "${FAILED[@]}" >&2
        return 1
    fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    build_all
fi
